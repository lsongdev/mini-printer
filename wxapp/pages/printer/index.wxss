.screen {
  padding: 24rpx 30rpx calc(48rpx + env(safe-area-inset-bottom));
}

.section {
  margin-bottom: 28rpx;
}

.section-title {
  display: block;
  margin: 0 16rpx 14rpx;
  color: #66666d;
  font-size: 26rpx;
  font-weight: 600;
}

.card {
  overflow: hidden;
  padding: 26rpx;
  border-radius: 24rpx;
  background: #fff;
}

.detail {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
  min-height: 46rpx;
  margin-bottom: 12rpx;
}

.detail-label {
  flex: 1;
  color: #72727a;
}

.detail-value {
  flex: 1;
  text-align: right;
  word-break: break-all;
}

.hint {
  display: block;
  color: #72727a;
  line-height: 1.5;
}

.device-button {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  margin: 0;
  padding: 18rpx 4rpx;
  border-bottom: 1rpx solid #ededf0;
  border-radius: 0;
  background: transparent;
  color: #1c1c1e;
  text-align: left;
  line-height: 1.35;
}

.device-button::after {
  border: none;
}

.device-content {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.device-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 500;
}

.device-detail {
  margin-top: 5rpx;
  color: #72727a;
  font-size: 24rpx;
}

.device-action {
  flex-shrink: 0;
  margin-left: 16rpx;
  color: #0a84ff;
  font-size: 26rpx;
}

.primary-button,
.secondary-button {
  width: 100%;
  margin-top: 18rpx;
  border-radius: 16rpx;
  font-weight: 500;
}

.primary-button {
  background: #0a84ff;
  color: #fff;
}

.secondary-button {
  background: #f1f2f5;
  color: #0a84ff;
}

.first-button {
  margin-top: 0;
}

.photo-preview {
  display: block;
  width: 100%;
  height: 420rpx;
  margin-top: 20rpx;
}

.density {
  margin-bottom: 0;
}

.progress {
  margin: 20rpx 0 0;
}

.offscreen-canvas {
  position: absolute;
  left: -9999rpx;
  top: 0;
  width: 1rpx;
  height: 1rpx;
  opacity: 0;
  pointer-events: none;
}
